APP_ENV=development
LOG_LEVEL=INFO

# Backend services. Local development uses a file-backed SQLite database and no Redis.
DATABASE_URL=sqlite+aiosqlite:///./data/skyflip.db
REDIS_URL=
AUTO_CREATE_SCHEMA=true
LOCAL_COLLECTOR_ENABLED=true
APP_SECRET=change-me-in-development
HYPIXEL_API_KEY=
HYPIXEL_BASE_URL=https://api.hypixel.net
# Keep false to use only upstream market data. Enable only when intentionally testing the
# clearly labelled local fixture through the development-only demo endpoint.
LOCAL_DEMO_ENABLED=false

# Browser-facing URLs. HYPIXEL_API_KEY must never be placed in a NEXT_PUBLIC variable.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_URL=http://localhost:8000/api/events
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Market policy is centralized here and in app/services/bazaar_engine.py.
BAZAAR_SELL_FEE_RATE=0.0125
BAZAAR_BUY_FEE_RATE=0
BAZAAR_STALE_AFTER_SECONDS=120
BAZAAR_POLL_SECONDS=30
BAZAAR_MAX_RETRIES=3
